<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RaidPad</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0414;CS0169;CS0649</NoWarn>
    <ModVersion>0.6.0</ModVersion>
    <EftManaged>..\..\..\EscapeFromTarkov_Data\Managed</EftManaged>
    <SptPlugins>..\..\..\BepInEx\plugins\spt</SptPlugins>
    <BepInExCore>..\..\..\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- EFT / game -->
    <Reference Include="Assembly-CSharp"><HintPath>$(EftManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(EftManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(EftManaged)\Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort.Unity"><HintPath>$(EftManaged)\Comfort.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Utilities"><HintPath>$(EftManaged)\Sirenix.Utilities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(EftManaged)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization.Config"><HintPath>$(EftManaged)\Sirenix.Serialization.Config.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes"><HintPath>$(EftManaged)\Sirenix.OdinInspector.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(EftManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine"><HintPath>$(EftManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(EftManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(EftManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(EftManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(EftManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(EftManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(EftManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(EftManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(EftManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(EftManaged)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(EftManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(EftManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Postprocessing.Runtime"><HintPath>$(EftManaged)\Unity.Postprocessing.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(EftManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule"><HintPath>$(EftManaged)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(EftManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommonExtensions"><HintPath>$(EftManaged)\CommonExtensions.dll</HintPath><Private>false</Private></Reference>

    <!-- SPT -->
    <Reference Include="spt-reflection"><HintPath>$(SptPlugins)\spt-reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-common"><HintPath>$(SptPlugins)\spt-common.dll</HintPath><Private>false</Private></Reference>

    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>

    <!-- SharpDX (controller input, bundled with the mod) -->
    <Reference Include="SharpDX"><HintPath>..\libs\SharpDX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.XInput"><HintPath>..\libs\SharpDX.XInput.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
  </ItemGroup>

  <Target Name="GeneratePluginInfo" BeforeTargets="BeforeBuild">
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/PluginInfo.g.cs"
      Lines="namespace RaidPad { internal static class PluginInfo { public const string Version = &quot;$(ModVersion)&quot;%3B } }"
      Overwrite="true" />
  </Target>

  <Target Name="FinalizeBuild" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ItemGroup>
      <_OutputFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <ItemGroup>
      <_Assets Include="$(MSBuildProjectDirectory)/assets/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/../../../build/RaidPad/assets/sounds" />
    <Copy SourceFiles="@(_OutputFiles)" DestinationFolder="$(MSBuildProjectDirectory)/../../../build/RaidPad" />
    <Copy SourceFiles="@(_Assets)" DestinationFolder="$(MSBuildProjectDirectory)/../../../build/RaidPad/assets/%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)/../../../build/RaidPad" DestinationFile="$(MSBuildProjectDirectory)/../../../build/RaidPad-$(ModVersion).zip" Overwrite="true" />
  </Target>

</Project>
